{
  "name": "editforge-studio",
  "version": "3.0.0",
  "private": true,
  "description": "EDITFORGE Creative Video Editing Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.editforge.studio",
    "productName": "EDITFORGE Studio",
    "files": [
      "index.html",
      "main.js",
      "manifest.webmanifest",
      "service-worker.js",
      "icon.svg"
    ],
    "win": {
      "target": "portable"
    }
  }
}